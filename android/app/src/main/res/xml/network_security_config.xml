<?xml version="1.0" encoding="utf-8"?>
<!-- 仅放行本地回环明文：just_audio 设置自定义请求头时会经 127.0.0.1 本地代理转发音频流。
     外部域名仍强制 HTTPS，不降低整体安全水位。 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <!-- QQ 音乐 / 酷狗 的匿名播放直链、网易云历史封面为 http CDN -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">qq.com</domain>
        <domain includeSubdomains="true">kugou.com</domain>
        <domain includeSubdomains="true">kglink.cn</domain>
        <domain includeSubdomains="true">126.net</domain>
        <domain includeSubdomains="true">163.com</domain>
    </domain-config>
</network-security-config>
